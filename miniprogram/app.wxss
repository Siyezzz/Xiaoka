/* 全局样式 */
page {
  background: #EBF8F2;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1A1A1A;
  -webkit-tap-highlight-color: transparent;
}

/* 固定返回键导航条（通用）*/
.page-nav-fixed {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  padding: 0 40rpx;
}

/* 自定义返回按钮（导航页面） */
.page-nav-row {
  display: flex;
  align-items: center;
  height: 72rpx;
  width: 100%;
  align-self: stretch;
}
.page-nav-back {
  color: rgba(255,255,255,0.92);
  font-size: 50rpx;
  font-weight: 300;
  line-height: 1;
  padding: 0 6rpx;
  transition: opacity 0.15s, transform 0.15s;
}

/* ── 全局微互动 hover 状态 ── */
.press      { opacity: 0.76; transform: scale(0.965); }
.press-sm   { opacity: 0.66; transform: scale(0.94);  }
.press-text { opacity: 0.42; transform: scale(0.97);  }
.back-press { opacity: 0.50; transform: scale(0.88);  }

.container {
  padding: 0 32rpx;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow:
    0 1rpx 2rpx rgba(0,0,0,0.06),
    0 4rpx 12rpx rgba(0,0,0,0.08),
    0 16rpx 40rpx rgba(0,0,0,0.06);
  transition: opacity 0.12s ease, transform 0.12s ease;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(150deg, #52CDA8, #2EBB92);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow:
    0 4rpx 0 rgba(28,135,96,0.30),
    0 12rpx 32rpx rgba(69,197,160,0.42),
    inset 0 1rpx 0 rgba(255,255,255,0.25);
}

.btn-primary::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #AAAAAA;
}
