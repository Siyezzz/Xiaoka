.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 116rpx;
  background: rgba(255,255,255,0.88);
  -webkit-backdrop-filter: blur(32px) saturate(2.0);
  backdrop-filter: blur(32px) saturate(2.0);
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
  border-top: 1rpx solid rgba(69,197,160,0.18);
  box-shadow:
    0 -4rpx 20rpx rgba(0,0,0,0.06),
    0 -16rpx 40rpx rgba(0,0,0,0.03);
}

.tab-bar-border {
  display: none;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-top: 8rpx;
  transition: opacity 0.12s ease, transform 0.12s ease;
}

.tab-press {
  opacity: 0.55;
  transform: scale(0.86);
}

.tab-icon-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  font-size: 36rpx;
  line-height: 1;
}

.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #FF3B30;
  border: 2rpx solid #fff;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.tab-dot-plain {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF3B30;
  border: 2rpx solid #fff;
}

.tab-label {
  font-size: 26rpx;
  color: #BBBBBB;
  letter-spacing: 1rpx;
}

.active .tab-label {
  color: #45C5A0;
  font-weight: 600;
}
