page { height: 100%; background: #F7F8FC; }

.success-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  pointer-events: none;
}

.success-card {
  background: rgba(20, 20, 20, 0.85);
  border: 1rpx solid rgba(255,255,255,0.10);
  border-radius: 48rpx;
  padding: 48rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.32);
  animation: successPop 1.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes successPop {
  0%   { transform: scale(0.6) translateY(20rpx); opacity: 0; }
  20%  { transform: scale(1.05); opacity: 1; }
  35%  { transform: scale(1); opacity: 1; }
  80%  { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.94) translateY(-10rpx); opacity: 0; }
}

.success-emoji { font-size: 64rpx; line-height: 1; }

.success-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.success-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
  letter-spacing: 0.5rpx;
}

.page {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding-top: 60rpx;
}

.top-tag {
  background: #45C5A014;
  color: #45C5A0;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.sub {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 56rpx;
}

/* wrapper clips the button into a perfect circle */
.avatar-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  overflow: hidden;
  flex-shrink: 0;
  align-self: center;
  margin-bottom: 48rpx;
  border: 3rpx dashed #D8D8D8;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.07);
  position: relative;
}

/* Invisible tap target — sits on top of the circle, no visual */
.avatar-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 0;
  background: rgba(0, 0, 0, 0);
  border: none;
  z-index: 5;
}

.avatar-btn::after { border: none; }

.btn-press { opacity: 0.72; }

.avatar-img-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 200rpx;
  height: 200rpx;
  display: block;
  pointer-events: none;
}

.upload-indicator {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
}

/* Centered visual — lives outside the button so flex works reliably */
.avatar-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  z-index: 1;
}

.avatar-cam { font-size: 52rpx; line-height: 1; }

.avatar-hint {
  font-size: 22rpx;
  color: #CCC;
}

.nickname-wrap {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  border: 2rpx solid #EBEBEB;
  margin-bottom: 40rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.nickname-input {
  width: 100%;
  height: 104rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  box-sizing: border-box;
  padding: 0 32rpx;
}

.nick-ph { color: #CCC; font-weight: 400; font-size: 30rpx; }

.save-btn {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: linear-gradient(135deg, #52CDA8, #2EBB92);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  box-shadow:
    0 4rpx 16rpx rgba(69,197,160,0.28),
    0 12rpx 32rpx rgba(45,140,111,0.14),
    inset 0 1rpx 0 rgba(255,255,255,0.45);
  margin-bottom: 28rpx;
  transition: opacity 0.15s, transform 0.15s;
}

.save-btn::after { border: none; }

