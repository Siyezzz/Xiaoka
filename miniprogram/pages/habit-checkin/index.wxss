.page {
  min-height: 100vh;
  background: #EBF8F2;
  padding-bottom: 120rpx;
}

/* 固定返回键背景色（动态颜色通过 inline style 设置）*/

/* ===== 头部（随页面滚动）===== */
.header {
  padding: 0 40rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0 0 40rpx 40rpx;
}

.header-icon-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.header-icon { font-size: 60rpx; }
.header-name { font-size: 45rpx; font-weight: 700; color: #fff; margin-bottom: 6rpx; }
.header-sub { font-size: 30rpx; color: rgba(255,255,255,0.85); display: flex; align-items: center; gap: 12rpx; }
.streak-badge { background: rgba(255,255,255,0.2); padding: 4rpx 18rpx; border-radius: 20rpx; font-weight: 600; }
.header-goal { font-size: 26rpx; color: rgba(255,255,255,0.78); margin-top: 10rpx; font-style: italic; }

/* ===== 7天状态 ===== */
.status-card {
  margin: -24rpx 32rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow:
    0 1rpx 2rpx rgba(0,0,0,0.06),
    0 4rpx 12rpx rgba(0,0,0,0.08),
    0 16rpx 40rpx rgba(0,0,0,0.06);
}
.status-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.status-label { font-size: 28rpx; color: #555; font-weight: 600; }
.status-badge { font-size: 24rpx; font-weight: 600; padding: 8rpx 22rpx; border-radius: 20rpx; }
.badge-done { background: #E8F8F4; color: #45C5A0; }
.badge-todo { background: #FFF3E0; color: #F7971E; }

.recent-days { display: flex; justify-content: space-between; }
.day-dot { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.dot-circle { width: 34rpx; height: 34rpx; border-radius: 50%; background: #EBEBEB; }
.dot-today .dot-circle { box-shadow: 0 0 0 3rpx #45C5A0; }
.dot-label { font-size: 20rpx; color: #BBB; }
.dot-today .dot-label { color: #45C5A0; font-weight: 600; }

/* ===== 计时器卡片 ===== */
.timer-card {
  margin: 0 32rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow:
    0 1rpx 2rpx rgba(0,0,0,0.06),
    0 4rpx 12rpx rgba(0,0,0,0.08),
    0 16rpx 40rpx rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

/* ===== 圆环 ===== */
.ring-container {
  position: relative;
  width: 280rpx;
  height: 280rpx;
}

.ring-track {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 12rpx solid #F0F0F0;
}

.ring-progress {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 12rpx solid;
  transition: opacity 0.4s ease;
}

.ring-inner {
  position: absolute;
  inset: 20rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.time-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #333;
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.idle-num { color: #CCC; }

.time-hint { font-size: 24rpx; color: #AAA; }
.hint-running { color: #45C5A0; }
.hint-paused { color: #F7971E; }

/* done 状态圆环内容 */
.done-check {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1;
}

.done-hint { font-size: 26rpx; font-weight: 600; }

.skip-dur {
  font-size: 42rpx;
  font-weight: 700;
  color: #888;
  line-height: 1;
}

.done-congrats {
  font-size: 28rpx;
  color: #45C5A0;
  font-weight: 600;
}

/* ===== 预设按钮 ===== */
.preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: center;
}

.preset-btn {
  padding: 12rpx 26rpx;
  border-radius: 30rpx;
  border: 1.5rpx solid rgba(69,197,160,0.22);
  font-size: 26rpx;
  color: #45C5A0;
  background: rgba(255,255,255,0.88);
  box-shadow: 0 1rpx 4rpx rgba(69,197,160,0.08), inset 0 1rpx 0 rgba(255,255,255,0.9);
  transition: background-color 0.15s, border-color 0.15s, color 0.15s, opacity 0.15s, transform 0.15s;
}

/* ===== 自定义输入 ===== */
.custom-wrap {
  display: flex;
  align-items: center;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  width: 100%;
  box-sizing: border-box;
}
.custom-input { flex: 1; height: 80rpx; font-size: 30rpx; color: #333; }
.custom-unit { font-size: 28rpx; color: #888; }

/* ===== 控制按钮行 ===== */
.ctrl-row {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-start {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow:
    0 1rpx 0 rgba(0,0,0,0.1),
    0 6rpx 20rpx rgba(0,0,0,0.14),
    inset 0 1rpx 0 rgba(255,255,255,0.20);
  transition: opacity 0.15s, transform 0.15s;
}
.btn-start::after { border: none; }

.btn-skip-text { font-size: 26rpx; color: #AAA; padding: 6rpx 24rpx; transition: opacity 0.15s; }

.ctrl-btn {
  padding: 18rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: opacity 0.15s, transform 0.15s;
}

.pause-btn { background: rgba(69,197,160,0.1); color: #45C5A0; border: 1rpx solid rgba(69,197,160,0.22); }
.stop-btn { background: rgba(235,87,87,0.08); color: #EB5757; border: 1rpx solid rgba(235,87,87,0.18); }

.timer-tip { font-size: 22rpx; color: #CCC; text-align: center; }
.paused-for-tip { font-size: 24rpx; font-weight: 600; color: #F7971E; text-align: center; }

/* ===== 打卡详情 ===== */
.note-card {
  margin: 0 32rpx 12rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow:
    0 1rpx 2rpx rgba(0,0,0,0.06),
    0 4rpx 12rpx rgba(0,0,0,0.08),
    0 16rpx 40rpx rgba(0,0,0,0.06);
}

.note-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }

/* ===== 拍照记录 ===== */
.photo-section { margin-bottom: 20rpx; }

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.photo-item {
  position: relative;
  width: 152rpx;
  height: 152rpx;
}

.photo-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: 14rpx;
  background: #F0F0F0;
}

.photo-remove {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.52);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.photo-add-btn {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  transition: opacity 0.15s, transform 0.15s;
}

.photo-add-dim { opacity: 0.55; }
.photo-add-icon { font-size: 34rpx; }
.photo-add-text { font-size: 28rpx; color: #666; font-weight: 500; }

.note-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #333;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  line-height: 1.7;
}

/* ===== 底部操作 ===== */
.action-wrap {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.btn-main {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow:
    0 1rpx 0 rgba(0,0,0,0.1),
    0 6rpx 20rpx rgba(0,0,0,0.14),
    inset 0 1rpx 0 rgba(255,255,255,0.20);
  transition: opacity 0.15s, transform 0.15s;
}
.btn-main::after { border: none; }
.btn-main.btn-dim { opacity: 0.65; }

.btn-danger-text { font-size: 26rpx; color: #CCC; padding: 8rpx 24rpx; transition: opacity 0.15s; }

.btn-discard {
  font-size: 26rpx;
  color: #BBB;
  padding: 10rpx 32rpx;
  text-align: center;
  transition: opacity 0.15s;
}

.btn-quick-checkin {
  font-size: 28rpx;
  font-weight: 600;
  padding: 14rpx 40rpx;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  text-align: center;
  transition: opacity 0.15s;
  margin-top: 4rpx;
}

/* ===== 手动填写时长 ===== */
.manual-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3F3F3;
}
.manual-label { font-size: 24rpx; color: #BBB; white-space: nowrap; }
.manual-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F7F8FC;
  border-radius: 14rpx;
  padding: 0 16rpx;
  height: 68rpx;
}
.manual-input { flex: 1; height: 68rpx; font-size: 28rpx; color: #333; }
.manual-unit { font-size: 22rpx; color: #AAA; }
.manual-btn {
  padding: 14rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* ===== 打卡历史 ===== */
.history-card {
  margin: 24rpx 32rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow:
    0 1rpx 2rpx rgba(0,0,0,0.06),
    0 4rpx 12rpx rgba(0,0,0,0.08),
    0 16rpx 40rpx rgba(0,0,0,0.06);
}
.history-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 32rpx 16rpx;
}
.history-title-bar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 3rpx;
  flex-shrink: 0;
}
.history-title { font-size: 28rpx; font-weight: 700; color: #333; }
.history-empty { padding: 28rpx 32rpx; }
.history-empty-text { font-size: 26rpx; color: #CCC; }
.history-item {
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
  gap: 16rpx;
}
.history-item:last-child { border-bottom: none; }
.hist-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  overflow: hidden;
}
.hist-idx { font-size: 24rpx; font-weight: 600; color: #555; min-width: 96rpx; font-variant-numeric: tabular-nums; flex-shrink: 0; }
.hist-dur { font-size: 26rpx; color: #333; min-width: 80rpx; flex-shrink: 0; }
.hist-note { font-size: 22rpx; color: #BBB; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.hist-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.hist-edit {
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  transition: opacity 0.15s, transform 0.15s;
}

.hist-cancel {
  font-size: 24rpx;
  color: #BBB;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: #F7F8FC;
  flex-shrink: 0;
  transition: opacity 0.15s, transform 0.15s;
}

/* 编辑打卡记录弹窗 */
.edit-hist-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.edit-hist-box {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 40rpx 60rpx;
}

.edit-hist-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.edit-hist-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.edit-hist-label {
  font-size: 28rpx;
  color: #888;
  width: 120rpx;
  flex-shrink: 0;
}

.edit-hist-input {
  flex: 1;
  height: 80rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.edit-hist-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.edit-hist-cancel {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #888;
  transition: opacity 0.15s;
}

.edit-hist-save {
  flex: 2;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  transition: opacity 0.15s;
}

.edit-hist-save-dim { opacity: 0.55; }

.edit-hist-photo-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.edit-hist-photo-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  overflow: visible;
}

.edit-hist-photo-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  display: block;
}

.edit-hist-photo-rm {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.edit-hist-photo-add {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  border: 2rpx dashed #CCC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 300;
}

.edit-hist-photo-dim { opacity: 0.5; }

/* ===== 加载 ===== */
.loading-wrap { display: flex; align-items: center; justify-content: center; padding: 120rpx; }
.loading-text { font-size: 28rpx; color: #CCC; }

/* ===== 成就解锁弹窗 ===== */
.badge-popup {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  background: rgba(69, 197, 160, 0.18);
  backdrop-filter: blur(12px);
}

.badge-popup-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 44rpx;
  padding: 56rpx 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border: 1.5rpx solid rgba(69, 197, 160, 0.25);
  box-shadow: 0 20rpx 64rpx rgba(69, 197, 160, 0.22), 0 2rpx 12rpx rgba(0,0,0,0.06);
  backdrop-filter: blur(24px);
  animation: badge-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.bp-unlock-lbl {
  font-size: 22rpx;
  color: #45C5A0;
  letter-spacing: 3rpx;
  margin-bottom: 4rpx;
}

.bp-icon { font-size: 88rpx; line-height: 1; }

.bp-name {
  font-size: 42rpx;
  font-weight: 800;
  color: #2BAE8A;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.bp-desc {
  font-size: 24rpx;
  color: rgba(69, 197, 160, 0.8);
  margin-top: 2rpx;
}

.bp-tap-hint {
  font-size: 20rpx;
  color: #C5C5C5;
  margin-top: 28rpx;
  letter-spacing: 2rpx;
}

@keyframes badge-pop {
  0%   { transform: scale(0.5) translateY(20rpx); opacity: 0; }
  60%  { transform: scale(1.06) translateY(0); opacity: 1; }
  80%  { transform: scale(0.97); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* ===== 页面进入动画 ===== */
@keyframes card-in {
  from { opacity: 0; transform: translateY(18rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.header-icon-wrap { animation: card-in 0.28s ease-out 0.04s both; }
.header-name      { animation: card-in 0.28s ease-out 0.08s both; }
.header-sub       { animation: card-in 0.28s ease-out 0.11s both; }
.header-goal      { animation: card-in 0.28s ease-out 0.13s both; }

.status-card  { animation: card-in 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.06s both; }
.timer-card   { animation: card-in 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.13s both; }
.note-card    { animation: card-in 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.19s both; }
.action-wrap  { animation: card-in 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.16s both; }
.history-card { animation: card-in 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.23s both; }
