.page {
  min-height: 100vh;
  background: #EBF8F2;
  padding-bottom: 100rpx;
}

.nav-fixed {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: transparent;
}

.nav-row {
  height: 90rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.nav-back {
  font-size: 52rpx;
  color: #156B4F;
  font-weight: 300;
  width: 60rpx;
  line-height: 1;
}

.content {
  padding: 48rpx 48rpx 60rpx;
}

.page-title-wrap {
  margin-bottom: 52rpx;
}

.page-title {
  display: inline-block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1A7A5E;
  background: #C8EFE3;
  border-radius: 20rpx;
  padding: 10rpx 28rpx;
  letter-spacing: 1rpx;
}

.para {
  font-size: 30rpx;
  line-height: 1.85;
  color: #1A6B50;
  margin-bottom: 40rpx;
  text-align: justify;
}

.emphasis {
  font-weight: 700;
  color: #0E5C40;
}

.bold {
  font-weight: 700;
  color: #0E5C40;
}

.italic {
  font-style: italic;
}

.signature {
  margin-top: 60rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid rgba(21,107,79,0.18);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.sig-label {
  font-size: 26rpx;
  color: #3A9070;
}

.sig-name {
  display: inline-block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1A7A5E;
  background: #C8EFE3;
  border-radius: 20rpx;
  padding: 10rpx 32rpx;
  letter-spacing: 4rpx;
}

.sig-date {
  font-size: 24rpx;
  color: #3A9070;
  margin-top: 4rpx;
}
