<view class="scroll-blur-bottom"></view>
<scroll-view
  class="page"
  scroll-y
  enhanced="{{true}}"
  bounces="{{false}}"
  refresher-enabled="{{true}}"
  refresher-triggered="{{isRefreshing}}"
  bindrefresherrefresh="onRefresh"
>
  <!-- 烟花画布 -->
  <canvas type="2d" id="confettiCanvas" class="confetti-canvas"></canvas>

  <!-- 顶部 Header -->
  <view class="header">
    <view style="height: {{statusBarHeight}}px"></view>
    <view class="date-str">{{dateStr}} {{weekDay}}</view>
    <view class="greeting">{{greeting}}</view>
  </view>

  <!-- 进度卡片 -->
  <view class="progress-card" wx:if="{{totalCount > 0}}" bindtap="onTapBarTheme">
    <view class="progress-info">
        <view class="progress-title-wrap">
          <text class="progress-title">今日进度</text>
          <view wx:if="{{allDoneStreak > 0}}" class="done-streak-pill">
            <text class="done-streak-plus">+</text>
            <text class="done-streak-num">{{allDoneStreak}}</text>
            <text class="done-streak-unit">天</text>
          </view>
        </view>
        <text class="progress-right"><text style="color: #45C5A0; font-weight: 800;">{{doneCount}}</text> / {{totalCount}}</text>
      </view>
    <view class="progress-bar-wrap">
      <view class="progress-bar" style="width: {{progress}}%; background: {{barGradient}}; box-shadow: 0 0 10rpx {{barShadow}}, inset 0 1rpx 0 rgba(255,255,255,0.45);"></view>
    </view>
    <view class="progress-tip progress-congrats" wx:if="{{progress === 100}}">今天的习惯都完成了，你真棒 🎉</view>
    <view class="progress-tip" wx:elif="{{progress >= 50}}">已经超过一半啦，加油 💪</view>
    <view class="progress-tip" wx:else>一小步也是进步，开始吧 🌟</view>
  </view>

  <!-- 加载状态 -->
  <block wx:if="{{loading}}">
    <view class="loading-wrap">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>
  </block>

  <!-- 空状态 -->
  <block wx:elif="{{habits.length === 0 && freeHabits.length === 0}}">
    <view class="empty-state">
      <view class="empty-icon">🌱</view>
      <view class="empty-text">今天还没有习惯</view>
      <view class="empty-sub">坚持就是力量，从今天开始</view>
      <button class="btn-add-first" bindtap="onAddHabit" hover-class="press" hover-stay-time="100">添加习惯</button>
    </view>
  </block>

  <!-- 习惯列表 -->
  <block wx:else>
    <view class="habit-list" wx:if="{{habits.length > 0}}">
      <view
        class="habit-item {{item.checked ? 'checked' : ''}} {{item.lightup ? 'habit-checking' : ''}}"
        wx:for="{{habits}}"
        wx:key="_id"
        bindtap="onHabitTap"
        data-id="{{item._id}}"
        data-color="{{item.color}}"
        hover-class="habit-hover"
        hover-stay-time="120"
      >
        <view class="habit-main-row">
          <view class="habit-icon-wrap" style="background: {{item.color || '#4ECDC4'}}44">
            <text class="habit-icon">{{item.icon || '📌'}}</text>
          </view>
          <view class="habit-info">
            <view class="habit-name-row">
              <view class="name-pill-group">
                <text class="habit-name {{item.checked ? 'name-done' : ''}}">{{item.name}}</text>
                <view wx:if="{{item.todayDuration > 0 && !item.timerState}}" class="habit-dur-pill" style="background: {{item.color || '#45C5A0'}}18">
                  <text class="habit-dur-pill-txt" style="color: {{item.color || '#45C5A0'}}">{{item.durLabel}}</text>
                </view>
              </view>
              <text class="habit-goal" wx:if="{{item.goal && !item.timerState}}" style="color:{{item.color}}">{{item.goal}}</text>
            </view>
            <view class="habit-meta" wx:if="{{item.todayPhotos && item.todayPhotos.length > 0}}">
              <image
                wx:for="{{item.todayPhotos}}"
                wx:for-item="purl"
                wx:for-index="pi"
                wx:key="pi"
                class="meta-photo-thumb"
                src="{{purl}}"
                mode="aspectFill"
                catchtap="onPreviewTodayPhoto"
                data-habitid="{{item._id}}"
                data-index="{{pi}}"
              />
            </view>
            <view class="habit-timer" wx:if="{{item.timerState}}" style="color:{{item.color || '#45C5A0'}}">
              <text>{{item.timerState === 'running' ? '⏱ 正在计时' : '⏸ 计时暂停'}} {{item.timerDisplay}}</text>
            </view>
          </view>
          <view
            class="checkin-btn {{item.checked ? 'checkin-done' : ''}} {{item.lightup ? 'checkin-lighting' : ''}}"
            style="{{item.checked ? 'background:' + (item.color || '#45C5A0') + '; border: none; box-shadow: 0 4rpx 14rpx ' + (item.color || '#45C5A0') + '48, 0 10rpx 24rpx ' + (item.color || '#45C5A0') + '30, inset 0 1rpx 0 rgba(255,255,255,0.45)' : ''}}"
            catchtap="onCheckin"
            data-id="{{item._id}}"
            hover-class="checkin-hover"
            hover-stay-time="80"
          >
            <text class="checkin-icon" wx:if="{{item.todayCount > 1}}">{{item.todayCount}}</text>
            <text class="checkin-icon" wx:elif="{{item.checked}}">✓</text>
          </view>
        </view>
        <view class="habit-sweep {{item.lightup ? 'habit-sweep-active' : ''}}" style="background: {{item.color || '#45C5A0'}}"></view>
      </view>
    </view>

    <!-- 自由打卡分区 -->
    <view class="free-section-header" wx:if="{{freeHabits.length > 0}}">
      <view class="free-section-divider"></view>
      <text class="free-section-label">自由打卡</text>
      <view class="free-section-divider"></view>
    </view>
    <view class="habit-list" wx:if="{{freeHabits.length > 0}}">
      <view
        class="habit-item {{item.checked ? 'checked' : ''}} {{item.lightup ? 'habit-checking' : ''}}"
        wx:for="{{freeHabits}}"
        wx:key="_id"
        bindtap="onHabitTap"
        data-id="{{item._id}}"
        data-color="{{item.color}}"
        hover-class="habit-hover"
        hover-stay-time="120"
      >
        <view class="habit-main-row">
          <view class="habit-icon-wrap" style="background: {{item.color || '#4ECDC4'}}44">
            <text class="habit-icon">{{item.icon || '📌'}}</text>
          </view>
          <view class="habit-info">
            <view class="habit-name-row">
              <view class="name-pill-group">
                <text class="habit-name {{item.checked ? 'name-done' : ''}}">{{item.name}}</text>
                <view wx:if="{{item.todayDuration > 0 && !item.timerState}}" class="habit-dur-pill" style="background: {{item.color || '#45C5A0'}}18">
                  <text class="habit-dur-pill-txt" style="color: {{item.color || '#45C5A0'}}">{{item.durLabel}}</text>
                </view>
              </view>
              <text class="habit-goal" wx:if="{{item.goal && !item.timerState}}" style="color:{{item.color}}">{{item.goal}}</text>
            </view>
            <view class="habit-meta" wx:if="{{item.todayPhotos && item.todayPhotos.length > 0}}">
              <image
                wx:for="{{item.todayPhotos}}"
                wx:for-item="purl"
                wx:for-index="pi"
                wx:key="pi"
                class="meta-photo-thumb"
                src="{{purl}}"
                mode="aspectFill"
                catchtap="onPreviewTodayPhoto"
                data-habitid="{{item._id}}"
                data-index="{{pi}}"
              />
            </view>
            <view class="habit-timer" wx:if="{{item.timerState}}" style="color:{{item.color || '#45C5A0'}}">
              <text>{{item.timerState === 'running' ? '⏱ 正在计时' : '⏸ 计时暂停'}} {{item.timerDisplay}}</text>
            </view>
          </view>
          <view
            class="checkin-btn {{item.checked ? 'checkin-done' : ''}} {{item.lightup ? 'checkin-lighting' : ''}}"
            style="{{item.checked ? 'background:' + (item.color || '#45C5A0') + '; border: none; box-shadow: 0 4rpx 14rpx ' + (item.color || '#45C5A0') + '48, 0 10rpx 24rpx ' + (item.color || '#45C5A0') + '30, inset 0 1rpx 0 rgba(255,255,255,0.45)' : ''}}"
            catchtap="onCheckin"
            data-id="{{item._id}}"
            hover-class="checkin-hover"
            hover-stay-time="80"
          >
            <text class="checkin-icon" wx:if="{{item.todayCount > 1}}">{{item.todayCount}}</text>
            <text class="checkin-icon" wx:elif="{{item.checked}}">✓</text>
          </view>
        </view>
        <view class="habit-sweep {{item.lightup ? 'habit-sweep-active' : ''}}" style="background: {{item.color || '#45C5A0'}}"></view>
      </view>
    </view>
  </block>

  <view style="height: 260rpx"></view>
</scroll-view>
