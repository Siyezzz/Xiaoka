page {
  overflow-x: hidden;
  height: 100vh;
}

.page {
  height: 100vh;
  background: #EBF8F2;
}

/* 下渐隐遮罩 */
.scroll-blur-bottom {
  position: fixed;
  bottom: 116rpx; left: 0; right: 0;
  height: 100rpx;
  background: linear-gradient(to top, #EBF8F2 0%, rgba(235,248,242,0) 100%);
  pointer-events: none;
  z-index: 101;
}

/* 烟花画布 */
.confetti-canvas {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  z-index: 9999;
}


/* 顶部绿条 */
.header {
  padding: 20rpx 40rpx 56rpx;
  background:
    linear-gradient(160deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 45%),
    linear-gradient(150deg, #3AC99E 0%, #22B085 60%, #189D74 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.date-str {
  font-size: 45rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.greeting {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
}


/* FAB 按钮 */
.fab {
  position: fixed;
  right: 48rpx;
  bottom: 220rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #52CDA8, #28AA84);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 2rpx 8rpx rgba(28,135,96,0.22),
    0 10rpx 32rpx rgba(69,197,160,0.42),
    inset 0 1rpx 0 rgba(255,255,255,0.30);
  z-index: 100;
  transition: transform 0.15s ease;
}

.fab-hover {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* 进度卡片 */
.progress-card {
  margin: -32rpx 28rpx 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  box-shadow:
    0 1rpx 2rpx rgba(0,0,0,0.06),
    0 6rpx 20rpx rgba(0,0,0,0.09),
    0 24rpx 48rpx rgba(0,0,0,0.07);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #45C5A0;
  letter-spacing: 2rpx;
  transform: translateY(2rpx);
}

.progress-right {
  font-size: 36rpx;
  color: #999;
}

.progress-right text {
  color: #45C5A0;
  font-weight: 800;
  font-size: 52rpx;
}



.progress-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.done-streak-pill {
  display: inline-flex;
  align-items: baseline;
  gap: 1rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  line-height: 1;
  background: #45C5A018;
  color: #45C5A0;
}

.done-streak-plus { font-size: 20rpx; font-weight: 700; }
.done-streak-num  { font-size: 24rpx; font-weight: 700; }
.done-streak-unit { font-size: 20rpx; font-weight: 600; }

.progress-bar-wrap {
  height: 12rpx;
  background: #EFEFEF;
  border-radius: 10rpx;
  margin-bottom: 14rpx;
}

.progress-bar {
  height: 100%;
  border-radius: 10rpx;
  min-width: 0;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: width;
}

.progress-tip {
  font-size: 26rpx;
  color: #ABABAB;
}

.progress-congrats {
  color: #1FA47A;
}

/* 章节标题 */
.section-title {
  margin: 0 28rpx 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #B8B8B8;
  letter-spacing: 1.5rpx;
}


/* 加载状态 */
.loading-wrap {
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(69, 197, 160, 0.2);
  border-top-color: #45C5A0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #AAA;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  margin: 40rpx 32rpx;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 28rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #AAA;
  margin-bottom: 48rpx;
  text-align: center;
}

.btn-add-first {
  background: linear-gradient(150deg, #52CDA8, #2EBB92);
  color: #fff;
  border: none;
  padding: 0 56rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow:
    0 2rpx 8rpx rgba(28,135,96,0.20),
    0 10rpx 28rpx rgba(69,197,160,0.36),
    inset 0 1rpx 0 rgba(255,255,255,0.25);
  transition: opacity 0.15s, transform 0.15s;
}

.btn-add-first::after { border: none; }

/* 自由打卡分区标题 */
.free-section-header {
  margin: 24rpx 28rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.free-section-divider {
  flex: 1;
  height: 1rpx;
  background: #E8E8E8;
}

.free-section-label {
  font-size: 24rpx;
  color: #BBBBBB;
  font-weight: 500;
  white-space: nowrap;
}

/* 习惯列表 */
.habit-list {
  margin: 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.habit-item {
  position: relative;
  background: #FFFFFF;
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow:
    0 1rpx 2rpx rgba(0,0,0,0.05),
    0 4rpx 12rpx rgba(0,0,0,0.07),
    0 16rpx 32rpx rgba(0,0,0,0.05);
  transition: opacity 0.1s ease, transform 0.1s ease;
}

.habit-main-row {
  padding: 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.habit-item.checked {
  opacity: 0.6;
}

.habit-item.habit-checking {
  opacity: 1;
  transform: scale(1.02);
  z-index: 10;
}

.habit-sweep {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  border-radius: 24rpx;
  pointer-events: none;
  opacity: 0;
  transform: translateX(-100%);
  z-index: 0;
}

.habit-sweep-active {
  animation: habitSweep 1.1s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

@keyframes habitSweep {
  0%   { transform: translateX(-100%); opacity: 0.28; }
  50%  { transform: translateX(0);     opacity: 0.28; }
  78%  { transform: translateX(0);     opacity: 0.16; }
  100% { transform: translateX(0);     opacity: 0; }
}

.habit-hover {
  transform: scale(0.975);
  opacity: 0.88;
}

.habit-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.habit-icon {
  font-size: 40rpx;
}

.habit-info {
  flex: 1;
}

.habit-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
  overflow: hidden;
}

.name-pill-group {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  overflow: hidden;
}

.habit-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex-shrink: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.habit-name.name-done {
  color: #C8C8C8;
}

.habit-goal {
  font-size: 26rpx;
  font-weight: 500;
  color: #999;
  flex-shrink: 1;
  white-space: nowrap;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.habit-meta {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #C8C8C8;
  margin-top: 5rpx;
}

.habit-freq {
  color: #3DB88E;
  font-weight: 500;
}

.habit-timer {
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 8rpx;
  letter-spacing: 0.5rpx;
}


.habit-checkin-tag {
  color: #AAA;
}

.habit-checkin-tag.note-tag {
  color: #4ECDC4;
}

.meta-photo-thumb {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.12);
}

.checkin-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(0,0,0,0.10);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: none;
  transition: opacity 0.1s ease, transform 0.1s ease;
}

.checkin-hover {
  transform: scale(1.14);
  border-color: #45C5A0;
}

.checkin-icon {
  font-size: 30rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

.checkin-lighting {
  animation: checkinPulse 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes checkinPulse {
  0%   { transform: scale(1); }
  35%  { transform: scale(1.28); }
  65%  { transform: scale(1.10); }
  100% { transform: scale(1); }
}

/* 今日时长 pill */
.habit-dur-pill {
  display: inline-flex;
  align-items: baseline;
  padding: 3rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.habit-dur-pill-txt {
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* 近期照片条 */
.habit-photo-strip {
  border-top: 1rpx solid #F5F5F5;
  padding: 12rpx 20rpx 16rpx;
}

.habit-photo-scroll {
  white-space: nowrap;
  width: 100%;
}

.habit-photo-thumb {
  display: inline-block;
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 10rpx;
  vertical-align: top;
  background: #F0F0F0;
}

