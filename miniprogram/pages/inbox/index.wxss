.page {
  min-height: 100vh;
  background: #EBF8F2;
  padding-bottom: 100rpx;
}

.nav-fixed {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background:
    linear-gradient(160deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0) 45%),
    linear-gradient(150deg, #3AC99E 0%, #22B085 60%, #189D74 100%);
}

.nav-row {
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-back {
  font-size: 52rpx;
  color: #fff;
  font-weight: 300;
  width: 60rpx;
  line-height: 1;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.loading-tip {
  text-align: center;
  color: #AAA;
  font-size: 28rpx;
  padding-top: 120rpx;
}

/* 发送区 */
.send-card {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
}

.send-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 10rpx;
}

.send-hint {
  font-size: 24rpx;
  color: #AAA;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.send-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  border: 1rpx solid #E8E8E8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #FAFAFA;
}

.send-ph { color: #CCC; }

.send-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.char-count { font-size: 24rpx; color: #CCC; }

.send-btn {
  background: #3AC99E;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 14rpx 44rpx;
  transition: opacity 0.15s, transform 0.15s;
}

.send-btn-dim { opacity: 0.5; }

/* 消息列表 */
.section { margin: 28rpx 32rpx 0; }

.section-title {
  font-size: 26rpx;
  color: #3AC99E;
  font-weight: 600;
  margin-bottom: 16rpx;
  letter-spacing: 0.5rpx;
}

.msg-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.msg-content {
  font-size: 29rpx;
  color: #333;
  line-height: 1.7;
}

.msg-date {
  font-size: 23rpx;
  color: #CCC;
  margin-top: 12rpx;
}

.replies { margin-top: 20rpx; }

.reply-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 14rpx;
}

.reply-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #3AC99E;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.reply-bubble {
  flex: 1;
  background: #EBF8F2;
  border-radius: 0 16rpx 16rpx 16rpx;
  padding: 16rpx 20rpx;
  font-size: 27rpx;
  color: #1A6B50;
  line-height: 1.6;
}

.no-reply {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #DDD;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding-top: 120rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; color: #555; font-weight: 500; }
.empty-hint { font-size: 26rpx; color: #AAA; margin-top: 10rpx; }

/* 作者管理视图 */
.admin-msg-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.admin-msg-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.admin-sender-av {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #B2DFD4;
  color: #0E5C40;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.admin-sender-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.admin-msg-date {
  font-size: 23rpx;
  color: #CCC;
}

.admin-msg-content {
  font-size: 29rpx;
  color: #444;
  line-height: 1.7;
}

.admin-replies { margin-top: 20rpx; }

.admin-reply-row {
  background: #EBF8F2;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
}

.admin-reply-prefix {
  font-size: 24rpx;
  color: #3AC99E;
  font-weight: 600;
}

.admin-reply-text {
  font-size: 27rpx;
  color: #1A6B50;
  line-height: 1.6;
}

.reply-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
}

.reply-input {
  flex: 1;
  font-size: 27rpx;
  color: #333;
  min-height: 60rpx;
}

.reply-ph { color: #CCC; }

.reply-send {
  background: #3AC99E;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 30rpx;
  padding: 10rpx 30rpx;
  flex-shrink: 0;
  transition: opacity 0.15s, transform 0.15s;
}

.reply-send-dim { opacity: 0.5; }

.reply-toggle-btn {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #3AC99E;
  font-weight: 500;
  transition: opacity 0.12s;
}
