<view class="tut-wrap">

  <!-- Progress dots -->
  <view class="tut-header" style="padding-top: {{statusBarHeight + 14}}px">
    <view class="step-dots">
      <view
        class="step-dot {{i < currentStep ? 'dot-done' : (i === currentStep ? 'dot-cur' : '')}}"
        wx:for="{{totalSteps}}" wx:key="*this" wx:for-item="i"
      ></view>
    </view>
  </view>

  <swiper
    class="tut-swiper"
    current="{{currentStep}}"
    bindchange="onSwiperChange"
    duration="320"
    easing-function="easeInOutCubic"
  >

    <!-- ===== Step 0: Welcome ===== -->
    <swiper-item>
      <view class="tut-slide">
        <view class="illus" style="margin-top: 48rpx">
          <image class="welcome-img" src="/images/app-icon.png" mode="aspectFit"></image>
        </view>
        <view class="tut-text">
          <view class="tut-tag">欢迎 ✨</view>
          <view class="tut-title">开启你的元气打卡之旅</view>
          <view class="tut-desc">每一个好习惯，都从今天的一小步开始。让我们用 1 分钟了解这个小程序吧！</view>
          <view class="tut-kaomoji">(ﾉ◕ヮ◕)ﾉ*:･ﾟ✧</view>
        </view>
        <view class="slide-nav">
          <view class="foot-full" bindtap="onNext" hover-class="foot-press" hover-stay-time="100">开始 →</view>
          <view class="foot-skip" bindtap="onSkip" hover-class="foot-skip-press" hover-stay-time="80">暂时跳过，随时可查看</view>
        </view>
      </view>
    </swiper-item>

    <!-- ===== Step 1: 今日主页 ===== -->
    <swiper-item>
      <view class="tut-slide">
        <view class="illus">
          <view class="mock-screen">
            <view class="ms-hdr">
              <view class="ms-date">4月25日 周五</view>
              <view class="ms-greet">早安，新的一天，元气满满 ☀️</view>
            </view>
            <view class="ms-prog-card">
              <view class="ms-prog-row">
                <view class="ms-prog-lbl">今日进度</view>
                <view class="ms-prog-num"><text class="ms-done-n">2</text> / 4</view>
              </view>
              <view class="ms-prog-bar"><view class="ms-prog-fill" style="width:50%"></view></view>
              <view class="ms-prog-tip">已经完成一半啦，加油 💪</view>
            </view>
            <view class="ms-sec-lbl">今日打卡</view>
            <view class="ms-habit-card">
              <view class="ms-hi-row">
                <view class="ms-hi-icon" style="background:#45C5A022">🏃</view>
                <view class="ms-hi-body"><view class="ms-hi-name">晨跑 30 分钟</view><view class="ms-hi-freq">每天</view></view>
                <view class="ms-hi-done" style="background:#45C5A0">✓</view>
              </view>
              <view class="ms-div"></view>
              <view class="ms-hi-row">
                <view class="ms-hi-icon" style="background:#FF6B6B22">📖</view>
                <view class="ms-hi-body"><view class="ms-hi-name">每日阅读</view><view class="ms-hi-freq">每天</view></view>
                <view class="ms-hi-check"></view>
              </view>
              <view class="ms-div"></view>
              <view class="ms-hi-row">
                <view class="ms-hi-icon" style="background:#AA96DA22">🧘</view>
                <view class="ms-hi-body"><view class="ms-hi-name">冥想 10 分钟</view><view class="ms-hi-freq">每天</view></view>
                <view class="ms-hi-check"></view>
              </view>
            </view>
            <view class="ms-tabbar">
              <view class="ms-tab ms-tab-on"><view class="ms-tab-dot"></view>今日</view>
              <view class="ms-tab">习惯</view>
              <view class="ms-tab">统计</view>
              <view class="ms-tab">好友</view>
            </view>
          </view>
        </view>
        <view class="tut-text">
          <view class="tut-title">打卡主页</view>
          <view class="tut-desc">今天要完成的习惯全在这里。快去<text class="hl">习惯</text>页面创建你的第一个好习惯吧！</view>
          <view class="tut-kaomoji">╰ (*°▽°*) ╯</view>
        </view>
        <view class="slide-nav">
          <view class="foot-row">
            <view class="foot-prev" bindtap="onPrev" hover-class="foot-prev-press" hover-stay-time="80">← 上一页</view>
            <view class="foot-next" bindtap="onNext" hover-class="foot-press" hover-stay-time="100">下一页 →</view>
          </view>
          <view class="foot-skip" bindtap="onSkip" hover-class="foot-skip-press" hover-stay-time="80">暂时跳过，随时可查看</view>
        </view>
      </view>
    </swiper-item>

    <!-- ===== Step 2: 创建习惯 ===== -->
    <swiper-item>
      <view class="tut-slide">
        <view class="illus">
          <view class="mock-screen">
            <view class="ms-hdr-preview">
              <view class="ms-prev-icon">🧘</view>
              <view class="ms-prev-name">每天冥想</view>
              <view class="ms-prev-freq">每天打卡</view>
            </view>
            <view class="ms-inner-body">
              <view class="ms-card-sec">
                <view class="ms-form-lbl">选择图标（可输入任意 Emoji）</view>
                <view class="ms-emoji-grid">
                  <text class="ms-ec">🏃</text><text class="ms-ec">📖</text><text class="ms-ec ms-ec-sel">🧘</text><text class="ms-ec">💧</text><text class="ms-ec">🎨</text><text class="ms-ec">🎸</text><text class="ms-ec">🏋</text><text class="ms-ec">🍎</text>
                  <text class="ms-ec">💪</text><text class="ms-ec">🌟</text><text class="ms-ec">🎯</text><text class="ms-ec">✍</text><text class="ms-ec">🌙</text><text class="ms-ec">🎵</text><text class="ms-ec">🍵</text><text class="ms-ec">🌱</text>
                </view>
              </view>
              <view class="ms-card-sec">
                <view class="ms-form-lbl">打卡频率</view>
                <view class="ms-ftabs">
                  <view class="ms-ftab ms-ftab-on">每天</view>
                  <view class="ms-ftab">每周</view>
                  <view class="ms-ftab ms-ftab-free">自由✦</view>
                </view>
              </view>
            </view>
            <view class="ms-tabbar">
              <view class="ms-tab">今日</view>
              <view class="ms-tab ms-tab-on"><view class="ms-tab-dot"></view>习惯</view>
              <view class="ms-tab">统计</view>
              <view class="ms-tab">好友</view>
            </view>
          </view>
        </view>
        <view class="tut-text">
          <view class="tut-title">定制你的习惯</view>
          <view class="tut-desc">给习惯起个名字，选择打卡频率：<text class="hl">每天</text>、<text class="hl">每周</text>指定天数，或<text class="hl">自由</text>打卡随时记录。</view>
          <view class="tut-kaomoji">♪ ( ^ ∇ ^ * )</view>
        </view>
        <view class="slide-nav">
          <view class="foot-row">
            <view class="foot-prev" bindtap="onPrev" hover-class="foot-prev-press" hover-stay-time="80">← 上一页</view>
            <view class="foot-next" bindtap="onNext" hover-class="foot-press" hover-stay-time="100">下一页 →</view>
          </view>
          <view class="foot-skip" bindtap="onSkip" hover-class="foot-skip-press" hover-stay-time="80">暂时跳过，随时可查看</view>
        </view>
      </view>
    </swiper-item>

    <!-- ===== Step 3: 打卡计时 ===== -->
    <swiper-item>
      <view class="tut-slide">
        <view class="illus">
          <view class="mock-screen">
            <view class="ms-hdr-checkin">
              <view class="ms-ci-icon">🧘</view>
              <view class="ms-ci-name">每天冥想</view>
              <view class="ms-ci-sub">每天打卡 · 🔥 连续 5 天</view>
            </view>
            <view class="ms-timer-card">
              <view class="ms-ring-wrap">
                <view class="ms-ring-track"></view>
                <view class="ms-ring-arc"></view>
                <view class="ms-ring-inner">
                  <view class="ms-time-val">08:42</view>
                  <view class="ms-time-lbl" style="color:#45C5A0">专注中</view>
                </view>
              </view>
              <view class="ms-presets">
                <view class="ms-pre">5分</view>
                <view class="ms-pre ms-pre-on">10分</view>
                <view class="ms-pre">25分</view>
                <view class="ms-pre">自定义</view>
              </view>
              <view class="ms-ctls">
                <view class="ms-pause">⏸ 暂停</view>
                <view class="ms-stop">✕ 取消</view>
              </view>
            </view>
            <view class="ms-detail-card">
              <view class="ms-photo-add">
                <view class="ms-photo-ico">📷</view>
                <view class="ms-photo-txt">拍照记录</view>
              </view>
              <view class="ms-note-box">记录今天的感受...</view>
            </view>
          </view>
        </view>
        <view class="tut-text">
          <view class="tut-title">计时 + 拍照打卡</view>
          <view class="tut-desc">选时长开始倒计时，专注完成任务。还可以<text class="hl">📷 拍照</text>留下成长记录，越打越有仪式感！</view>
          <view class="tut-kaomoji">( ง •̀_•́) ง</view>
        </view>
        <view class="slide-nav">
          <view class="foot-row">
            <view class="foot-prev" bindtap="onPrev" hover-class="foot-prev-press" hover-stay-time="80">← 上一页</view>
            <view class="foot-next" bindtap="onNext" hover-class="foot-press" hover-stay-time="100">下一页 →</view>
          </view>
          <view class="foot-skip" bindtap="onSkip" hover-class="foot-skip-press" hover-stay-time="80">暂时跳过，随时可查看</view>
        </view>
      </view>
    </swiper-item>

    <!-- ===== Step 4 (NEW): 轻触打卡 & 多次打卡 & 提醒 ===== -->
    <swiper-item>
      <view class="tut-slide">
        <view class="illus" style="margin-top: 30rpx">
          <view class="mock-screen mock-screen-sm">
            <view class="ms-hdr">
              <view class="ms-date">4月25日 周五</view>
              <view class="ms-greet">今天状态不错💪</view>
            </view>
            <view class="ms-prog-card">
              <view class="ms-prog-row">
                <view class="ms-prog-lbl">今日进度</view>
                <view class="ms-prog-num"><text class="ms-done-n">2</text> / 4</view>
              </view>
              <view class="ms-prog-bar"><view class="ms-prog-fill" style="width:50%"></view></view>
              <view class="ms-prog-tip">已经完成一半啦，加油！</view>
            </view>
            <view class="ms-sec-lbl">今日打卡</view>
            <view class="ms-habit-card">
              <view class="ms-hi-row">
                <view class="ms-hi-icon" style="background:#45C5A022">🏃</view>
                <view class="ms-hi-body"><view class="ms-hi-name">晨跑 30 分钟</view><view class="ms-hi-freq">每天</view></view>
                <view class="ms-hi-done" style="background:#45C5A0">✓</view>
              </view>
              <view class="ms-div"></view>
              <view class="ms-hi-row">
                <view class="ms-hi-icon" style="background:#4A90E222">💧</view>
                <view class="ms-hi-body"><view class="ms-hi-name">喝水 8 杯</view><view class="ms-hi-freq">自由打卡</view></view>
                <view class="ms-hi-done ms-hi-count" style="background:#45C5A0">3</view>
              </view>
              <view class="ms-div"></view>
              <view class="ms-hi-row">
                <view class="ms-hi-icon" style="background:#AA96DA22">📖</view>
                <view class="ms-hi-body"><view class="ms-hi-name">每日阅读</view><view class="ms-hi-freq">每天</view></view>
                <view class="ms-hi-check"></view>
              </view>
            </view>
            <view class="ms-tabbar">
              <view class="ms-tab ms-tab-on"><view class="ms-tab-dot"></view>今日</view>
              <view class="ms-tab">习惯</view>
              <view class="ms-tab">统计</view>
              <view class="ms-tab">好友</view>
            </view>
          </view>
        </view>
        <view class="tut-text">
          <view class="tut-title">轻触打卡，时刻同行</view>
          <view class="tut-desc">点击右侧<text class="hl">圆点</text>，免计时快速打卡，多次点击还能<text class="hl">累积次数</text>。将消息提醒设为<text class="hl">永久允许</text>，每日准时收到提醒，轻松开启健康作息~</view>
          <view class="tut-kaomoji">(￣︶￣)↗[GO!]</view>
        </view>
        <view class="slide-nav">
          <view class="foot-row">
            <view class="foot-prev" bindtap="onPrev" hover-class="foot-prev-press" hover-stay-time="80">← 上一页</view>
            <view class="foot-next" bindtap="onNext" hover-class="foot-press" hover-stay-time="100">下一页 →</view>
          </view>
          <view class="foot-skip" bindtap="onSkip" hover-class="foot-skip-press" hover-stay-time="80">暂时跳过，随时可查看</view>
        </view>
      </view>
